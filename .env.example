# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.
# See docs/DEPLOYMENT.md for what each of these is, where to get it, and which ones
# differ between local/staging/production.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
OPENAI_API_KEY=
ADMIN_TOKEN=

# development | staging | production — see docs/DEPLOYMENT.md's environment strategy.
# Controls whether the in-process scheduler runs (development only) and, indirectly,
# what CORS_ALLOWED_ORIGINS should be set to.
ENVIRONMENT=development

# Comma-separated. Leave empty in production — native iOS doesn't need CORS at all.
CORS_ALLOWED_ORIGINS=

LOG_LEVEL=INFO
